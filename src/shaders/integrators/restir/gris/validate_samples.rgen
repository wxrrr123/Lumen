#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_atomic_float : require

#if VALIDATE_DUMMY_WORDS > 0
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_control_flow_attributes : require
#endif

#ifdef ENABLE_VALIDATE_REORDER_CALL
#extension GL_NV_shader_invocation_reorder : require
#endif

#define SCENE_TEX_IDX 9
#include "gris_commons.glsl"
layout(binding = 4, scalar) buffer PathReconnections { ReconnectionData reconnection_data[]; };
layout(binding = 5, scalar) readonly buffer InReservoirs { Reservoir in_headers[]; };
layout(binding = 6, scalar) readonly buffer CurrGBuffer { GBuffer curr_gbuffers[]; };
layout(binding = 7, scalar) readonly buffer InImportanceFlags { uint in_flags[]; };
layout(binding = 8, scalar) readonly buffer CompactData { GrisData compact_data[]; };
uvec4 seed = init_rng(gl_LaunchIDEXT.xy, gl_LaunchSizeEXT.xy, pc.general_seed);
uvec4 seed2 = init_rng(gl_LaunchIDEXT.xy, gl_LaunchSizeEXT.xy, neighbor_offset_seed_base());

#ifdef PROFILE_VALIDATE_COST_KEY
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer DebugVisBuffer { uint d[]; };
DebugVisBuffer debug_vis = DebugVisBuffer(scene_desc.debug_vis_addr);
#endif

#ifdef ENABLE_VALIDATE_COST_SINK
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer ValidateCostSinkBuffer { uint d[]; };
ValidateCostSinkBuffer validate_cost_sink = ValidateCostSinkBuffer(scene_desc.gris_cost_sink_addr);
#endif

#ifdef PROFILE_REPLAY_RAY_COUNT
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer ReplayRayCountBuffer { uint d[]; };
ReplayRayCountBuffer replay_ray_count = ReplayRayCountBuffer(scene_desc.gris_replay_ray_count_addr);
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer ReplayShadowRayCountBuffer { uint d[]; };
ReplayShadowRayCountBuffer replay_shadow_ray_count = ReplayShadowRayCountBuffer(scene_desc.gris_replay_shadow_ray_count_addr);
#endif

// Classroom at 1850x1016, depth 8, N=3 measured a 0-18 cost-key range after warmup. Five bits
// represent 0-31 and leave headroom without grouping values that differ in the measured range.
#define VALIDATE_COST_KEY_BITS 5

void main() {
#ifdef PROFILE_REPLAY_RAY_COUNT
	g_replay_ray_count = 0u;
	g_replay_shadow_ray_count = 0u;
	replay_ray_count.d[pixel_idx] = 0u;
	replay_shadow_ray_count.d[pixel_idx] = 0u;
#endif
	GBuffer gbuffer = curr_gbuffers[pixel_idx];
	Reservoir canonical_header = in_headers[pixel_idx];
	uint canonical_slot = in_flags[pixel_idx];
	bool canonical_valid = gbuffer_data_valid(gbuffer) && canonical_header.M != 0 && compact_slot_valid(canonical_slot);

	uint num_spatial_samples = pc.enable_spatial_reuse == 1 ? pc.num_spatial_samples : 0;
	uint cost_key = 0;

#if VALIDATE_DUMMY_WORDS > 0
	// Each word is a different ballot over the pre-reorder subgroup. A single
	// first-lane seed cannot reconstruct these masks after the subgroup changes
	// at reorderThreadNV(), so the masks must cross the reorder point in B.
	uint validate_dummy[VALIDATE_DUMMY_WORDS];
	uint dummy_state = pixel_idx ^ pc.general_seed ^ floatBitsToUint(canonical_header.W);
	[[unroll]] for (uint i = 0; i < VALIDATE_DUMMY_WORDS; i++) {
		dummy_state ^= dummy_state >> 16;
		dummy_state *= 0x7feb352du;
		dummy_state ^= dummy_state >> 15;
		dummy_state *= 0x846ca68bu;
		dummy_state ^= dummy_state >> 16;
		validate_dummy[i] = subgroupBallot((dummy_state & 1u) != 0u).x;
	}
#endif

#if defined(ENABLE_VALIDATE_COST_REORDER) || defined(PROFILE_VALIDATE_COST_KEY)
	// Keep the state live across reorderThreadNV small. The complete GrisData and HitData are loaded
	// after the reorder call; carrying both structures through SER causes a device loss on driver
	// 580.82.07, while the compute-only D variant succeeds.
	if (canonical_valid) {
		uint canonical_path_flags = compact_data[canonical_slot].path_flags;
		HitData cost_canonical_gbuffer =
			get_hitdata(gbuffer.barycentrics, gbuffer.primitive_instance_id.y, gbuffer.primitive_instance_id.x);
		uint rc_type, rc_prefix_length, rc_postfix_length;
		bool rc_side, is_directional_light;
		unpack_path_flags(canonical_path_flags, rc_type, rc_prefix_length, rc_postfix_length, rc_side,
						  is_directional_light);
		int remaining_budget = int(pc.max_depth) - int(rc_postfix_length) - 1;
		uint per_replay = min(rc_prefix_length, uint(max(0, remaining_budget)));

		uint valid_neighbors = 0;
		uvec4 cost_seed = seed2;
		for (uint i = 0; i < num_spatial_samples; i++) {
			ivec2 rand_offset = get_neighbor_offset(cost_seed);
			const ivec2 coords = ivec2(gl_LaunchIDEXT.xy) + rand_offset;
			if (any(lessThan(coords, ivec2(0))) || any(greaterThanEqual(coords, gl_LaunchSizeEXT.xy))) {
				continue;
			}
			const uint neighbor_pixel_idx = coords.x * pc.size_y + coords.y;

			Reservoir neighbor_header = in_headers[neighbor_pixel_idx];
			if (neighbor_header.W == 0.0 || neighbor_header.M == 0) {
				continue;
			}

			GBuffer neighbor_gbuffer = curr_gbuffers[neighbor_pixel_idx];
			if (!gbuffer_data_valid(neighbor_gbuffer)) {
				continue;
			}
			HitData unpacked_neighbor_gbuffer =
				get_hitdata(neighbor_gbuffer.barycentrics, neighbor_gbuffer.primitive_instance_id.y,
							neighbor_gbuffer.primitive_instance_id.x);

			float normal_sim = dot(cost_canonical_gbuffer.n_s, unpacked_neighbor_gbuffer.n_s);
			vec3 dist_vec = cost_canonical_gbuffer.pos - unpacked_neighbor_gbuffer.pos;
			float dist_sq = dot(dist_vec, dist_vec);
			const float normal_threshold = 0.99;
			const float dist_threshold_sq = pow(pc.scene_extent * 0.05, 2.0);
			if (normal_sim < normal_threshold || dist_sq > dist_threshold_sq) {
				continue;
			}
			valid_neighbors++;
		}
		cost_key = per_replay * valid_neighbors;
	}
#ifdef PROFILE_VALIDATE_COST_KEY
	debug_vis.d[pixel_idx] = cost_key;
#endif
#endif

#ifdef ENABLE_VALIDATE_COST_REORDER
#ifdef ENABLE_VALIDATE_REORDER_CALL
	reorderThreadNV(cost_key, VALIDATE_COST_KEY_BITS);
#endif
#elif defined(ENABLE_VALIDATE_REORDER_CALL)
	reorderThreadNV(0u, VALIDATE_COST_KEY_BITS);
#endif

#ifdef ENABLE_VALIDATE_COST_SINK
	uint sink_value = cost_key;
#if VALIDATE_DUMMY_WORDS > 0
	// During the dummy-state experiment, observe the first lane only after the
	// reorder point. Its identity can change in B/C, so the dependent fold
	// cannot be hoisted before reorderThreadNV(). N=0 uses the original sink.
	sink_value ^= subgroupBroadcastFirst(pixel_idx);
	[[unroll]] for (uint i = 0; i < VALIDATE_DUMMY_WORDS; i++) {
		sink_value ^= validate_dummy[i] + i;
		sink_value = (sink_value ^ (sink_value >> 16)) * 0x7feb352du;
	}
#endif
	validate_cost_sink.d[pixel_idx] = sink_value;
#endif
	// Every launch invocation reaches the reorder point above. In particular, variant B cannot gain
	// active-lane compaction merely because invalid canonical pixels returned before a constant-key
	// reorder. Invalid invocations use key 0 in C and return only after the common reorder point.
	if (!canonical_valid) return;

	GrisData canonical_data = compact_data[canonical_slot];
	HitData canonical_gbuffer =
		get_hitdata(gbuffer.barycentrics, gbuffer.primitive_instance_id.y, gbuffer.primitive_instance_id.x);

	for (uint i = 0; i < num_spatial_samples; i++) {
		ivec2 rand_offset = get_neighbor_offset(seed2);
		const ivec2 coords = ivec2(gl_LaunchIDEXT.xy) + rand_offset;
		const uint neighbor_pixel_idx = coords.x * pc.size_y + coords.y;
		if (any(lessThan(coords, ivec2(0))) || any(greaterThanEqual(coords, gl_LaunchSizeEXT.xy))) {
			continue;
		}

		Reservoir neighbor_header = in_headers[neighbor_pixel_idx];
		if (neighbor_header.W == 0.0 || neighbor_header.M == 0) {
			continue;
		}

		GBuffer neighbor_gbuffer = curr_gbuffers[neighbor_pixel_idx];
		if (!gbuffer_data_valid(neighbor_gbuffer)) {
			continue;
		}
		HitData unpacked_neighbor_gbuffer =
			get_hitdata(neighbor_gbuffer.barycentrics, neighbor_gbuffer.primitive_instance_id.y,
						neighbor_gbuffer.primitive_instance_id.x);

		float normal_sim = dot(canonical_gbuffer.n_s, unpacked_neighbor_gbuffer.n_s);
		vec3 dist_vec = canonical_gbuffer.pos - unpacked_neighbor_gbuffer.pos;
		float dist_sq = dot(dist_vec, dist_vec);

		const float normal_threshold = 0.99; 
		const float dist_threshold_sq = pow(pc.scene_extent * 0.05, 2.0);

		if (normal_sim < normal_threshold || dist_sq > dist_threshold_sq) {
			reconnection_data[(num_spatial_samples + 1) * pixel_idx + i + 1].target_pdf_in_neighbor = 0.0;
			continue; 
		}

		float target_pdf_in_neighbor = 0;
		vec3 primary_direction = get_primary_direction(uvec2(coords));
		retrace_paths_and_evaluate(unpacked_neighbor_gbuffer, canonical_data, primary_direction,
                                   target_pdf_in_neighbor);
		report_numeric_scalar(4u, 1u, canonical_header.W);
		report_numeric_scalar(4u, 3u, target_pdf_in_neighbor);
		report_numeric_scalar(4u, 4u, canonical_data.reservoir_contribution);
		reconnection_data[(num_spatial_samples + 1) * pixel_idx + i + 1].target_pdf_in_neighbor =
			target_pdf_in_neighbor;
	}
#ifdef PROFILE_REPLAY_RAY_COUNT
	replay_ray_count.d[pixel_idx] = g_replay_ray_count;
	replay_shadow_ray_count.d[pixel_idx] = g_replay_shadow_ray_count;
#endif
}
