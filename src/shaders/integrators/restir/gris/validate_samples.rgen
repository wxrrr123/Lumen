#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_atomic_float : require

#define SCENE_TEX_IDX 9
#include "gris_commons.glsl"
layout(binding = 4, scalar) buffer PathReconnections { ReconnectionData reconnection_data[]; };
layout(binding = 5, scalar) readonly buffer InReservoirs { Reservoir in_headers[]; };
layout(binding = 6, scalar) readonly buffer CurrGBuffer { GBuffer curr_gbuffers[]; };
layout(binding = 7, scalar) readonly buffer InImportanceFlags { uint in_flags[]; };
layout(binding = 8, scalar) readonly buffer CompactData { GrisData compact_data[]; };
uvec4 seed = init_rng(gl_LaunchIDEXT.xy, gl_LaunchSizeEXT.xy, pc.general_seed);
uvec4 seed2 = init_rng(gl_LaunchIDEXT.xy, gl_LaunchSizeEXT.xy, neighbor_offset_seed_base());

void main() {
	GBuffer gbuffer = curr_gbuffers[pixel_idx];
	if (!gbuffer_data_valid(gbuffer)) {
		return;
	}

	Reservoir canonical_header = in_headers[pixel_idx];
    if (canonical_header.M == 0) {
        return;
    }

	uint canonical_slot = in_flags[pixel_idx];
	if (!compact_slot_valid(canonical_slot)) return;
	GrisData canonical_data = compact_data[canonical_slot];

	HitData canonical_gbuffer =
		get_hitdata(gbuffer.barycentrics, gbuffer.primitive_instance_id.y, gbuffer.primitive_instance_id.x);

	uint num_spatial_samples = pc.enable_spatial_reuse == 1 ? pc.num_spatial_samples : 0;

	for (uint i = 0; i < num_spatial_samples; i++) {
		ivec2 rand_offset = get_neighbor_offset(seed2);
		const ivec2 coords = ivec2(gl_LaunchIDEXT.xy) + rand_offset;
		const uint neighbor_pixel_idx = coords.x * pc.size_y + coords.y;
		if (any(lessThan(coords, ivec2(0))) || any(greaterThanEqual(coords, gl_LaunchSizeEXT.xy))) {
			continue;
		}

		Reservoir neighbor_header = in_headers[neighbor_pixel_idx];
		if (neighbor_header.W == 0.0 || neighbor_header.M == 0) {
			continue;
		}

		GBuffer neighbor_gbuffer = curr_gbuffers[neighbor_pixel_idx];
		if (!gbuffer_data_valid(neighbor_gbuffer)) {
			continue;
		}
		HitData unpacked_neighbor_gbuffer =
			get_hitdata(neighbor_gbuffer.barycentrics, neighbor_gbuffer.primitive_instance_id.y,
						neighbor_gbuffer.primitive_instance_id.x);

		float normal_sim = dot(canonical_gbuffer.n_s, unpacked_neighbor_gbuffer.n_s);
		vec3 dist_vec = canonical_gbuffer.pos - unpacked_neighbor_gbuffer.pos;
		float dist_sq = dot(dist_vec, dist_vec);

		const float normal_threshold = 0.99; 
		const float dist_threshold_sq = pow(pc.scene_extent * 0.05, 2.0);

		if (normal_sim < normal_threshold || dist_sq > dist_threshold_sq) {
			reconnection_data[(num_spatial_samples + 1) * pixel_idx + i + 1].target_pdf_in_neighbor = 0.0;
			continue; 
		}

		float target_pdf_in_neighbor = 0;
		vec3 primary_direction = get_primary_direction(uvec2(coords));
		retrace_paths_and_evaluate(unpacked_neighbor_gbuffer, canonical_data, primary_direction,
                                   target_pdf_in_neighbor);
		reconnection_data[(num_spatial_samples + 1) * pixel_idx + i + 1].target_pdf_in_neighbor =
			target_pdf_in_neighbor;
	}
}
